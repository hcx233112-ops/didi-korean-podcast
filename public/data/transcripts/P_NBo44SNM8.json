{
  "videoId": "P_NBo44SNM8",
  "segments": [
    {
      "start": 0.0,
      "end": 2.62,
      "ko": "음... 한 가지 이야기해 드릴 게 있어요.",
      "zh": "음... 한 가지 이야기해 드릴 게 있어요."
    },
    {
      "start": 2.62,
      "end": 5.44,
      "ko": "제가 사실은 아주 조용하게 훌쩍",
      "zh": "제가 사실은 아주 조용하게 훌쩍"
    },
    {
      "start": 5.44,
      "end": 6.95,
      "ko": "일본을 다녀왔답니다",
      "zh": "일본을 다녀왔답니다"
    },
    {
      "start": 6.95,
      "end": 8.98,
      "ko": "오사카로 훌쩍 다녀왔습니다",
      "zh": "오사카로 훌쩍 다녀왔습니다"
    },
    {
      "start": 8.98,
      "end": 12.83,
      "ko": "지금 오사카는 まんパク? 라고 하나요? 일본어로는?",
      "zh": "지금 오사카는 まんパク? 라고 하나요? 일본어로는?"
    },
    {
      "start": 12.83,
      "end": 16.64,
      "ko": "국제박람회 엑스포 같은 거를 하고 있어가지고",
      "zh": "국제박람회 엑스포 같은 거를 하고 있어가지고"
    },
    {
      "start": 16.64,
      "end": 19.72,
      "ko": "관광객들이 진~~짜 많거든요",
      "zh": "관광객들이 진~~짜 많거든요"
    },
    {
      "start": 19.72,
      "end": 23.07,
      "ko": "국제박람회에 마스코트가 있더라고요",
      "zh": "국제박람회에 마스코트가 있더라고요"
    },
    {
      "start": 23.07,
      "end": 25.44,
      "ko": "오사카를 막 돌아다니다 보면",
      "zh": "오사카를 막 돌아다니다 보면"
    },
    {
      "start": 25.44,
      "end": 28.16,
      "ko": "그 마스코트가 엄청 많이 보여요",
      "zh": "그 마스코트가 엄청 많이 보여요"
    },
    {
      "start": 28.16,
      "end": 31.07,
      "ko": "그 마스코트가 어떻게 생겼냐면, 보여드릴게요",
      "zh": "그 마스코트가 어떻게 생겼냐면, 보여드릴게요"
    },
    {
      "start": 31.07,
      "end": 32.55,
      "ko": "이렇게 생겼습니다",
      "zh": "이렇게 생겼습니다"
    },
    {
      "start": 32.55,
      "end": 35.07,
      "ko": "음... 어때요?",
      "zh": "음... 어때요?"
    },
    {
      "start": 35.07,
      "end": 37.56,
      "ko": "솔직히 말하면 귀엽거나",
      "zh": "솔직히 말하면 귀엽거나"
    },
    {
      "start": 37.56,
      "end": 39.81,
      "ko": "예쁜 캐릭터는 아니잖아요",
      "zh": "예쁜 캐릭터는 아니잖아요"
    },
    {
      "start": 39.81,
      "end": 42.56,
      "ko": "일본이 잘하는 게 캐릭터화?",
      "zh": "일본이 잘하는 게 캐릭터화?"
    },
    {
      "start": 42.56,
      "end": 44.08,
      "ko": "뭐라 해야 되지? 홍보?",
      "zh": "뭐라 해야 되지? 홍보?"
    },
    {
      "start": 44.08,
      "end": 46.69,
      "ko": "마케팅을 진짜 잘하는 거 같거든요",
      "zh": "마케팅을 진짜 잘하는 거 같거든요"
    },
    {
      "start": 46.69,
      "end": 51.32,
      "ko": "막 이거 굿즈를 사려고 줄을 엄청 서 있고",
      "zh": "막 이거 굿즈를 사려고 줄을 엄청 서 있고"
    },
    {
      "start": 51.32,
      "end": 54.16,
      "ko": "인형 뽑기 같은 데에도 얘가 있어요",
      "zh": "인형 뽑기 같은 데에도 얘가 있어요"
    },
    {
      "start": 54.16,
      "end": 56.45,
      "ko": "그래서 저는 이제 한국에도",
      "zh": "그래서 저는 이제 한국에도"
    },
    {
      "start": 56.45,
      "end": 58.9,
      "ko": "이런 지역 마스코트들이 있거든요",
      "zh": "이런 지역 마스코트들이 있거든요"
    },
    {
      "start": 58.9,
      "end": 61.6,
      "ko": "근데 한국은 (마스코트) 마케팅 같은 거를",
      "zh": "근데 한국은 (마스코트) 마케팅 같은 거를"
    },
    {
      "start": 61.6,
      "end": 64.06,
      "ko": "잘 못하는 거 같아요 제가 생각했을 때는",
      "zh": "잘 못하는 거 같아요 제가 생각했을 때는"
    },
    {
      "start": 64.06,
      "end": 67.41,
      "ko": "안 되겠다 나도 좀 보여 드려야겠다",
      "zh": "안 되겠다 나도 좀 보여 드려야겠다"
    },
    {
      "start": 67.41,
      "end": 69.8,
      "ko": "한국의 마스코트 캐릭터들",
      "zh": "한국의 마스코트 캐릭터들"
    },
    {
      "start": 69.8,
      "end": 71.23,
      "ko": "보여드리도록 하겠습니다",
      "zh": "보여드리도록 하겠습니다"
    },
    {
      "start": 71.23,
      "end": 74.83,
      "ko": "이 마스코트는 여러분들이 지하철을 타거나",
      "zh": "이 마스코트는 여러분들이 지하철을 타거나"
    },
    {
      "start": 74.83,
      "end": 76.44,
      "ko": "아니면 길을 가거나",
      "zh": "아니면 길을 가거나"
    },
    {
      "start": 76.44,
      "end": 77.84,
      "ko": "건물에 들어가거나",
      "zh": "건물에 들어가거나"
    },
    {
      "start": 77.84,
      "end": 81.51,
      "ko": "포스터 같은 곳에서 발견하실 수도 있어요",
      "zh": "포스터 같은 곳에서 발견하실 수도 있어요"
    },
    {
      "start": 81.51,
      "end": 82.47,
      "ko": "딱 여행 왔을 때,",
      "zh": "딱 여행 왔을 때,"
    },
    {
      "start": 82.47,
      "end": 85.95,
      "ko": "'어 저 캐릭터 디디님이 말한 캐릭터인데?!'",
      "zh": "'어 저 캐릭터 디디님이 말한 캐릭터인데?!'"
    },
    {
      "start": 85.95,
      "end": 88.41,
      "ko": "발견하는 재미도 좀 있을 것 같습니다",
      "zh": "발견하는 재미도 좀 있을 것 같습니다"
    },
    {
      "start": 88.41,
      "end": 92.08,
      "ko": "자 그러면 서울 애들 부터 보여드릴게요",
      "zh": "자 그러면 서울 애들 부터 보여드릴게요"
    },
    {
      "start": 92.08,
      "end": 94.71,
      "ko": "서울특별시의 캐릭터는",
      "zh": "서울특별시의 캐릭터는"
    },
    {
      "start": 94.71,
      "end": 98.28,
      "ko": "'해치와 소울프렌즈' 라는 캐릭터에요",
      "zh": "'해치와 소울프렌즈' 라는 캐릭터에요"
    },
    {
      "start": 98.28,
      "end": 99.68,
      "ko": "얘네가 서울 캐릭터입니다",
      "zh": "얘네가 서울 캐릭터입니다"
    },
    {
      "start": 99.68,
      "end": 101.23,
      "ko": "보신 적 있어요, 여러분?",
      "zh": "보신 적 있어요, 여러분?"
    },
    {
      "start": 101.23,
      "end": 102.44,
      "ko": "원래는 이렇게 어머나...",
      "zh": "원래는 이렇게 어머나..."
    },
    {
      "start": 102.44,
      "end": 104.08,
      "ko": "원래는 이렇게 생겼구나",
      "zh": "원래는 이렇게 생겼구나"
    },
    {
      "start": 104.08,
      "end": 105.64,
      "ko": "잘 바꿨네",
      "zh": "잘 바꿨네"
    },
    {
      "start": 105.64,
      "end": 109.04,
      "ko": "이렇게 생긴 애들이 이제 살짝 이렇게 귀엽게",
      "zh": "이렇게 생긴 애들이 이제 살짝 이렇게 귀엽게"
    },
    {
      "start": 109.04,
      "end": 112.04,
      "ko": "요즘 스타일, 좀 세련된 스타일로 바뀌었고...",
      "zh": "요즘 스타일, 좀 세련된 스타일로 바뀌었고..."
    },
    {
      "start": 112.04,
      "end": 114.77,
      "ko": "\"서울특별시의 공식 마스코트입니다",
      "zh": "\"서울특별시의 공식 마스코트입니다"
    },
    {
      "start": 114.77,
      "end": 118.85,
      "ko": "이름과 모티브는 '해태'의 동의어인 '해치'\"...",
      "zh": "이름과 모티브는 '해태'의 동의어인 '해치'\"..."
    },
    {
      "start": 118.85,
      "end": 121.61,
      "ko": "'해태'는 전설 속의 동물이에요",
      "zh": "'해태'는 전설 속의 동물이에요"
    },
    {
      "start": 121.61,
      "end": 124.16,
      "ko": "이렇게 생긴 거 본 적 있나요?",
      "zh": "이렇게 생긴 거 본 적 있나요?"
    },
    {
      "start": 124.16,
      "end": 126.25,
      "ko": "얘가 사자래요 사자",
      "zh": "얘가 사자래요 사자"
    },
    {
      "start": 126.25,
      "end": 130.02,
      "ko": "\"해태 관련 유물\"... 아, 방금 보여드린 거 있잖아요",
      "zh": "\"해태 관련 유물\"... 아, 방금 보여드린 거 있잖아요"
    },
    {
      "start": 130.02,
      "end": 131.75,
      "ko": "아까 이런 돌같이 생긴 거",
      "zh": "아까 이런 돌같이 생긴 거"
    },
    {
      "start": 131.75,
      "end": 134.52,
      "ko": "이런 것들이 서울에 제일 많대요",
      "zh": "이런 것들이 서울에 제일 많대요"
    },
    {
      "start": 134.52,
      "end": 138.77,
      "ko": "이런 해태 관련 조각상들이 서울에 제일 많아서",
      "zh": "이런 해태 관련 조각상들이 서울에 제일 많아서"
    },
    {
      "start": 138.77,
      "end": 141.92,
      "ko": "서울의 마스코트 캐릭터는 이 해치, 해태",
      "zh": "서울의 마스코트 캐릭터는 이 해치, 해태"
    },
    {
      "start": 141.92,
      "end": 143.52,
      "ko": "똑같은 말이래요",
      "zh": "똑같은 말이래요"
    },
    {
      "start": 143.52,
      "end": 146.05,
      "ko": "이 캐릭터로 사용을 하고 있고",
      "zh": "이 캐릭터로 사용을 하고 있고"
    },
    {
      "start": 146.05,
      "end": 149.1,
      "ko": "아, '기후 동행카드 디자인이 해치에요'?",
      "zh": "아, '기후 동행카드 디자인이 해치에요'?"
    },
    {
      "start": 149.1,
      "end": 150.39,
      "ko": "그렇구나~",
      "zh": "그렇구나~"
    },
    {
      "start": 150.39,
      "end": 154.5,
      "ko": "제가 또 서울에 안 살아서 잘 모르는 걸 수도 있어요",
      "zh": "제가 또 서울에 안 살아서 잘 모르는 걸 수도 있어요"
    },
    {
      "start": 154.5,
      "end": 155.72,
      "ko": "여러분들 아세요?",
      "zh": "여러분들 아세요?"
    },
    {
      "start": 155.72,
      "end": 159.43,
      "ko": "서울 여행할 때 '기후동행카드'라는 걸 쓰면",
      "zh": "서울 여행할 때 '기후동행카드'라는 걸 쓰면"
    },
    {
      "start": 159.43,
      "end": 162.8,
      "ko": "좀 더 할인해서 버스, 지하철 이런 거 탈 수 있는",
      "zh": "좀 더 할인해서 버스, 지하철 이런 거 탈 수 있는"
    },
    {
      "start": 162.8,
      "end": 164.3,
      "ko": "서울 (교통)카드가 있어요",
      "zh": "서울 (교통)카드가 있어요"
    },
    {
      "start": 164.3,
      "end": 169.65,
      "ko": "그거의 캐릭터가 해치, 아까 그 캐릭터들이라고 하네요",
      "zh": "그거의 캐릭터가 해치, 아까 그 캐릭터들이라고 하네요"
    },
    {
      "start": 169.65,
      "end": 172.93,
      "ko": "경기도 마스코트는 이렇게 생겼습니다",
      "zh": "경기도 마스코트는 이렇게 생겼습니다"
    },
    {
      "start": 172.93,
      "end": 173.65,
      "ko": "보여요?",
      "zh": "보여요?"
    },
    {
      "start": 173.65,
      "end": 177.3,
      "ko": "이름은 봉공이, 봉공이라는 캐릭터에요",
      "zh": "이름은 봉공이, 봉공이라는 캐릭터에요"
    },
    {
      "start": 177.3,
      "end": 180.83,
      "ko": "그래서 여기 재밌는게 캐릭터 스토리가 있더라구요",
      "zh": "그래서 여기 재밌는게 캐릭터 스토리가 있더라구요"
    },
    {
      "start": 180.83,
      "end": 183.99,
      "ko": "아 이런거 만드는 것도 재밌을 것 같지 않아요?",
      "zh": "아 이런거 만드는 것도 재밌을 것 같지 않아요?"
    },
    {
      "start": 183.99,
      "end": 188.22,
      "ko": "팀이 모여서 \"경기도의 마스코트를 만들어야 돼!\" 하면서",
      "zh": "팀이 모여서 \"경기도의 마스코트를 만들어야 돼!\" 하면서"
    },
    {
      "start": 188.22,
      "end": 191.61,
      "ko": "마스코트의 스토리를 이렇게 만드셨더라구요",
      "zh": "마스코트의 스토리를 이렇게 만드셨더라구요"
    },
    {
      "start": 191.61,
      "end": 195.65,
      "ko": "경기 원년 하늘과 땅, 물의 정기가 모이는 곳",
      "zh": "경기 원년 하늘과 땅, 물의 정기가 모이는 곳"
    },
    {
      "start": 195.65,
      "end": 198.43,
      "ko": "경기 원년 어쩌고 저쩌고 이거는 그냥",
      "zh": "경기 원년 어쩌고 저쩌고 이거는 그냥"
    },
    {
      "start": 198.43,
      "end": 201.99,
      "ko": "상상 속에 있는 연도인 것 같아요",
      "zh": "상상 속에 있는 연도인 것 같아요"
    },
    {
      "start": 201.99,
      "end": 205.18,
      "ko": "BC 1000 같은 그런 가상의 숫자입니다",
      "zh": "BC 1000 같은 그런 가상의 숫자입니다"
    },
    {
      "start": 205.18,
      "end": 207.68,
      "ko": "하늘과 땅, 물에 정기가 모이는 곳",
      "zh": "하늘과 땅, 물에 정기가 모이는 곳"
    },
    {
      "start": 207.68,
      "end": 210.02,
      "ko": "정기는 약간 기운? 이런 거예요",
      "zh": "정기는 약간 기운? 이런 거예요"
    },
    {
      "start": 210.02,
      "end": 212.61,
      "ko": "정신과 기운... 이런 느낌",
      "zh": "정신과 기운... 이런 느낌"
    },
    {
      "start": 212.61,
      "end": 214.86,
      "ko": "눈에 보이지 않는 뭔가 에너지",
      "zh": "눈에 보이지 않는 뭔가 에너지"
    },
    {
      "start": 214.86,
      "end": 216.77,
      "ko": "그런 것들을 '정기'라고 부릅니다",
      "zh": "그런 것들을 '정기'라고 부릅니다"
    },
    {
      "start": 216.77,
      "end": 219.77,
      "ko": "옛날 옛날에 한 새싹이 태어났어요",
      "zh": "옛날 옛날에 한 새싹이 태어났어요"
    },
    {
      "start": 219.77,
      "end": 223.07,
      "ko": "새싹은 항상 지상을 내려다보면서",
      "zh": "새싹은 항상 지상을 내려다보면서"
    },
    {
      "start": 223.07,
      "end": 226.21,
