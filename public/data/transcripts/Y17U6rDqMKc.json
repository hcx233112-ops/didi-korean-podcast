  "segments": [
    {
      "start": 0.0,
      "end": 3.09,
      "ko": "안녕하세요 한국어로 다양한 한국 문화에 대해 이야기하는",
      "zh": "안녕하세요 한국어로 다양한 한국 문화에 대해 이야기하는"
    },
    {
