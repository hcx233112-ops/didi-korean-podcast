{
  "videoId": "mO0jonxC_fE",
  "segments": [
    {
      "start": 5.32,
      "end": 9.35,
      "ko": "안녕하세요 <Didi의 한국어 Podcast>에 오신 여러분 반갑습니다",
      "zh": "안녕하세요 <Didi의 한국어 Podcast>에 오신 여러분 반갑습니다"
    },
    {
      "start": 9.35,
      "end": 13.31,
      "ko": "오늘은 2023년 7월 22일 토요일입니다",
      "zh": "오늘은 2023년 7월 22일 토요일입니다"
    },
    {
      "start": 13.31,
      "end": 14.3,
      "ko": "주말이네요",
      "zh": "주말이네요"
    },
    {
      "start": 14.3,
      "end": 17.42,
      "ko": "저는 사실 프리랜서가 되고 나서부터는",
      "zh": "저는 사실 프리랜서가 되고 나서부터는"
    },
    {
      "start": 17.42,
      "end": 20.83,
      "ko": "주말이라는 게 큰 의미가 없어졌어요",
      "zh": "주말이라는 게 큰 의미가 없어졌어요"
    },
    {
      "start": 20.83,
      "end": 24.24,
      "ko": "원래는 금요일만 손꼽아 기다리고",
      "zh": "원래는 금요일만 손꼽아 기다리고"
    },
    {
      "start": 24.24,
      "end": 26.5,
      "ko": "일요일에는 세상이 무너진 것처럼",
      "zh": "일요일에는 세상이 무너진 것처럼"
    },
    {
      "start": 26.5,
      "end": 29.25,
      "ko": "기운도 없고 그랬는데",
      "zh": "기운도 없고 그랬는데"
    },
    {
      "start": 29.25,
      "end": 30.94,
      "ko": "이제는 스케줄에 따라서",
      "zh": "이제는 스케줄에 따라서"
    },
    {
      "start": 30.94,
      "end": 32.86,
      "ko": "월요일부터 쉬기도 하고",
      "zh": "월요일부터 쉬기도 하고"
    },
    {
      "start": 32.86,
      "end": 34.59,
      "ko": "하루도 못 쉬기도 하고",
      "zh": "하루도 못 쉬기도 하고"
    },
    {
      "start": 34.59,
      "end": 36.08,
      "ko": "3일씩 쉬기도 하고",
      "zh": "3일씩 쉬기도 하고"
    },
    {
      "start": 36.08,
      "end": 38.88,
      "ko": "이렇게 뒤죽박죽이라서",
      "zh": "이렇게 뒤죽박죽이라서"
    },
    {
      "start": 38.88,
      "end": 42.47,
      "ko": "예전만큼 토요일이 기다려지지는 않는 것 같은데요",
      "zh": "예전만큼 토요일이 기다려지지는 않는 것 같은데요"
    },
    {
      "start": 42.47,
      "end": 43.97,
      "ko": "여러분들은 어떠신가요?",
      "zh": "여러분들은 어떠신가요?"
    },
    {
      "start": 43.97,
      "end": 47.72,
      "ko": "다들 주말 재밌게 편하게 잘 보내고 계신가요?",
      "zh": "다들 주말 재밌게 편하게 잘 보내고 계신가요?"
    },
    {
      "start": 47.72,
      "end": 49.71,
      "ko": "오늘은 저번 팟캐스트에 이어서",
      "zh": "오늘은 저번 팟캐스트에 이어서"
    },
    {
      "start": 49.71,
      "end": 51.72,
      "ko": "'한국의 연애'에 대해서",
      "zh": "'한국의 연애'에 대해서"
    },
    {
      "start": 51.72,
      "end": 54.26,
      "ko": "계속해서 얘기해 보려고 하는데요",
      "zh": "계속해서 얘기해 보려고 하는데요"
    },
    {
      "start": 54.26,
      "end": 57.4,
      "ko": "저번에는 한국인들은 어디서 어떻게",
      "zh": "저번에는 한국인들은 어디서 어떻게"
    },
    {
      "start": 57.4,
      "end": 60.87,
      "ko": "이성을 만나고 있는지에 대해서 얘기를 해봤었죠",
      "zh": "이성을 만나고 있는지에 대해서 얘기를 해봤었죠"
    },
    {
      "start": 60.87,
      "end": 63.07,
      "ko": "오늘은 그 다음 단계인",
      "zh": "오늘은 그 다음 단계인"
    },
    {
      "start": 63.07,
      "end": 68.45,
      "ko": "고백부터 실제 연애 기간에 대해서  얘기를 해보려고 합니다",
      "zh": "고백부터 실제 연애 기간에 대해서  얘기를 해보려고 합니다"
    },
    {
      "start": 68.45,
      "end": 71.83,
      "ko": "한국인들이 어떻게 연인이 되고",
      "zh": "한국인들이 어떻게 연인이 되고"
    },
    {
      "start": 71.83,
      "end": 74.65,
      "ko": "연애를 하는 동안에는 어떤 모습일지",
      "zh": "연애를 하는 동안에는 어떤 모습일지"
    },
    {
      "start": 74.65,
      "end": 77.25,
      "ko": "지금 바로 시작해 보도록 하겠습니다",
      "zh": "지금 바로 시작해 보도록 하겠습니다"
    },
    {
      "start": 86.62,
      "end": 90.42,
      "ko": "저번 에피소드에서 이야기했던 여러가지 방법들로",
      "zh": "저번 에피소드에서 이야기했던 여러가지 방법들로"
    },
    {
      "start": 90.42,
      "end": 93.58,
      "ko": "여자와 남자가 만나게 됐습니다",
      "zh": "여자와 남자가 만나게 됐습니다"
    },
    {
      "start": 93.58,
      "end": 97.76,
      "ko": "그때 상대방에게 '호감'이라는게 들기 시작합니다",
      "zh": "그때 상대방에게 '호감'이라는게 들기 시작합니다"
    },
    {
      "start": 97.76,
      "end": 99.51,
      "ko": "호감은 좋은 감정,",
      "zh": "호감은 좋은 감정,"
    },
    {
      "start": 99.51,
      "end": 103.49,
      "ko": "막 '좋아해', '사랑해' 이런거까지는 아니지만",
      "zh": "막 '좋아해', '사랑해' 이런거까지는 아니지만"
    },
    {
      "start": 103.49,
      "end": 105.16,
      "ko": "관심이 생기고",
      "zh": "관심이 생기고"
    },
    {
      "start": 105.16,
      "end": 107.81,
      "ko": "뭔가 궁금하고 신경쓰이고",
      "zh": "뭔가 궁금하고 신경쓰이고"
    },
    {
      "start": 107.81,
      "end": 110.1,
      "ko": "좀 좋은 느낌이 들기 시작하면",
      "zh": "좀 좋은 느낌이 들기 시작하면"
    },
    {
      "start": 110.1,
      "end": 111.98,
      "ko": "이걸 호감이라고 하는데요",
      "zh": "이걸 호감이라고 하는데요"
    },
    {
      "start": 111.98,
      "end": 114.37,
      "ko": "이런 호감이 들기 시작하면",
      "zh": "이런 호감이 들기 시작하면"
    },
    {
      "start": 114.37,
      "end": 117.12,
      "ko": "이 둘은 자주 만나기 시작하겠죠?",
      "zh": "이 둘은 자주 만나기 시작하겠죠?"
    },
    {
      "start": 117.12,
      "end": 120.42,
      "ko": "이 둘이 원래 알고 지냈던 사이라면",
      "zh": "이 둘이 원래 알고 지냈던 사이라면"
    },
    {
      "start": 120.42,
      "end": 124.5,
      "ko": "점점 같이 밥을 먹는 시간이 늘어나게 되고",
      "zh": "점점 같이 밥을 먹는 시간이 늘어나게 되고"
    },
    {
      "start": 124.5,
      "end": 127.45,
      "ko": "또 재밌는 영화가 나왔다 하면",
      "zh": "또 재밌는 영화가 나왔다 하면"
    },
    {
      "start": 127.45,
      "end": 130.88,
      "ko": "'아이 뭐 너 볼 사람 없으면 같이 볼래?'",
      "zh": "'아이 뭐 너 볼 사람 없으면 같이 볼래?'"
    },
    {
      "start": 130.88,
      "end": 134.13,
      "ko": "이렇게 재밌는 게 있으면 먼저 찾게 되고",
      "zh": "이렇게 재밌는 게 있으면 먼저 찾게 되고"
    },
    {
      "start": 134.13,
      "end": 138.29,
      "ko": "또 어쩌다 보니까 집에까지 데려다주게 되고",
      "zh": "또 어쩌다 보니까 집에까지 데려다주게 되고"
    },
    {
      "start": 138.29,
      "end": 141.75,
      "ko": "'이거는 친구끼리 하는 행동은 아니지 않나?' 하는",
      "zh": "'이거는 친구끼리 하는 행동은 아니지 않나?' 하는"
    },
    {
      "start": 141.75,
      "end": 144.47,
      "ko": "그런 생각들이 자꾸 들게 됩니다",
      "zh": "그런 생각들이 자꾸 들게 됩니다"
    },
    {
      "start": 144.47,
      "end": 149.63,
      "ko": "또 저번 에피소드에서 얘기했던 '소개팅'이나 '미팅', '헌팅' 같은 경우에는",
      "zh": "또 저번 에피소드에서 얘기했던 '소개팅'이나 '미팅', '헌팅' 같은 경우에는"
    },
    {
      "start": 149.63,
      "end": 151.9,
      "ko": "이 사람을 처음 만났잖아요",
      "zh": "이 사람을 처음 만났잖아요"
    },
    {
      "start": 151.9,
      "end": 156.14,
      "ko": "이 처음 만난 사람과 보낸 시간이 꽤 재밌는 거죠",
      "zh": "이 처음 만난 사람과 보낸 시간이 꽤 재밌는 거죠"
    },
    {
      "start": 156.14,
      "end": 158.24,
      "ko": "그래서 상대방한테",
      "zh": "그래서 상대방한테"
    },
    {
      "start": 158.24,
      "end": 161.37,
      "ko": "'괜찮으시면 혹시  다음에 또 만날래요?'",
      "zh": "'괜찮으시면 혹시  다음에 또 만날래요?'"
    },
    {
      "start": 161.37,
      "end": 163.07,
      "ko": "하고 물어봐요",
      "zh": "하고 물어봐요"
    },
    {
      "start": 163.07,
      "end": 166.15,
      "ko": "한국에서는 이걸 '애프터'라고 하는데",
      "zh": "한국에서는 이걸 '애프터'라고 하는데"
    },
    {
      "start": 166.15,
      "end": 167.7,
      "ko": "영어 단어의 'after'",
      "zh": "영어 단어의 'after'"
    },
    {
      "start": 167.7,
      "end": 172.43,
      "ko": "한 번 만난 그 이후에 또 다시 만난다라는 뜻입니다",
      "zh": "한 번 만난 그 이후에 또 다시 만난다라는 뜻입니다"
    },
    {
      "start": 172.43,
      "end": 176.4,
      "ko": "이렇게 애프터까지 해봐도 아까 말했던 것처럼",
      "zh": "이렇게 애프터까지 해봐도 아까 말했던 것처럼"
    },
    {
      "start": 176.4,
      "end": 180.12,
      "ko": "역시 호감도 생기면서 뭐 좀 신경 쓰이고",
      "zh": "역시 호감도 생기면서 뭐 좀 신경 쓰이고"
    },
    {
      "start": 180.12,
      "end": 181.89,
      "ko": "문자도 좀 더 자주 하게 되고",
      "zh": "문자도 좀 더 자주 하게 되고"
    },
    {
      "start": 181.89,
      "end": 186.63,
      "ko": "하다 보니까 그 이후로도 계속 만나게 되는 거예요",
      "zh": "하다 보니까 그 이후로도 계속 만나게 되는 거예요"
    },
    {
      "start": 186.63,
      "end": 190.3,
      "ko": "이렇게 호감을 가지고 영화를 같이 보기도 하고",
      "zh": "이렇게 호감을 가지고 영화를 같이 보기도 하고"
    },
    {
      "start": 190.3,
      "end": 193.26,
      "ko": "밥을 먹으러 가기도 하고 카페를 가기도 하고",
      "zh": "밥을 먹으러 가기도 하고 카페를 가기도 하고"
    },
    {
      "start": 193.26,
      "end": 197.25,
      "ko": "술도 같이 마시고 이러는 단계를 한국에서는",
      "zh": "술도 같이 마시고 이러는 단계를 한국에서는"
    },
    {
      "start": 197.25,
      "end": 198.88,
      "ko": "'썸'이라고 부릅니다",
      "zh": "'썸'이라고 부릅니다"
    },
    {
      "start": 198.88,
      "end": 204.05,
      "ko": "한국의 연애는 이 썸을 빼고는 이야기할 수가 없어요",
      "zh": "한국의 연애는 이 썸을 빼고는 이야기할 수가 없어요"
    },
    {
      "start": 204.05,
      "end": 206.1,
      "ko": "한국에 있는 어떤 연인이든",
      "zh": "한국에 있는 어떤 연인이든"
    },
    {
      "start": 206.1,
      "end": 211.95,
      "ko": "이 단계는, 이 썸 단계는 꼭 있었을 거라고 생각을 합니다",
      "zh": "이 단계는, 이 썸 단계는 꼭 있었을 거라고 생각을 합니다"
    },
    {
      "start": 211.95,
      "end": 215.4,
      "ko": "썸은 원래 영어의 something 이었어요",
      "zh": "썸은 원래 영어의 something 이었어요"
    },
    {
      "start": 215.4,
      "end": 216.35,
      "ko": "영어에서도",
      "zh": "영어에서도"
    },
    {
      "start": 216.35,
      "end": 219.45,
      "ko": "'There's something going on between them'",
      "zh": "'There's something going on between them'"
    },
    {
      "start": 219.45,
      "end": 221.75,
      "ko": "이런 표현이 있잖아요",
      "zh": "이런 표현이 있잖아요"
    },
    {
      "start": 221.75,
      "end": 223.48,
      "ko": "이게 어쩌다 보니까 한국에서는",
      "zh": "이게 어쩌다 보니까 한국에서는"
    },
    {
      "start": 223.48,
      "end": 226.21,
      "ko": "썸 한 글자로 줄어들게 됐어요",
      "zh": "썸 한 글자로 줄어들게 됐어요"
    },
    {
      "start": 226.21,
      "end": 230.63,
      "ko": "썸 단계에서는 계속 만나서, 계속 좋아서",
      "zh": "썸 단계에서는 계속 만나서, 계속 좋아서"
    },
    {
      "start": 230.63,
      "end": 233.55,
      "ko": "커플이 될 가능성도 있고",
      "zh": "커플이 될 가능성도 있고"
    },
    {
      "start": 233.55,
      "end": 238.14,
      "ko": "계속 만나다 보니까 좀 자연스럽게 멀어져서",
      "zh": "계속 만나다 보니까 좀 자연스럽게 멀어져서"
    },
    {
      "start": 238.14,
      "end": 241.95,
      "ko": "잘 안 되는 그런 가능성도 있는 단계입니다",
      "zh": "잘 안 되는 그런 가능성도 있는 단계입니다"
    },
    {
      "start": 241.95,
      "end": 245.58,
      "ko": "왜 한국 로맨스 드라마 같은 걸 보다 보면은",
      "zh": "왜 한국 로맨스 드라마 같은 걸 보다 보면은"
    },
    {
      "start": 245.58,
      "end": 251.36,
      "ko": "주인공들이 한 1화, 2화에서 어떻게 저렇게 해가지고 만나서",
      "zh": "주인공들이 한 1화, 2화에서 어떻게 저렇게 해가지고 만나서"
    },
    {
      "start": 251.36,
      "end": 257.98,
      "ko": "한 5화에서 6화 정도 됐을 때 슬슬 설레는 장면들,",
      "zh": "한 5화에서 6화 정도 됐을 때 슬슬 설레는 장면들,"
    },
    {
      "start": 257.98,
      "end": 262.71,
      "ko": "뭔가 귀여운 그런 장면들이 나오기 시작하잖아요",
      "zh": "뭔가 귀여운 그런 장면들이 나오기 시작하잖아요"
    },
    {
      "start": 262.71,
      "end": 266.11,
      "ko": "영화관에서 이렇게 팝콘을 먹다가",
      "zh": "영화관에서 이렇게 팝콘을 먹다가"
    },
    {
      "start": 266.11,
      "end": 267.8,
      "ko": "손이 닿아서...",
      "zh": "손이 닿아서..."
    },
    {
