    },
    {
      "start": 219.61,
      "end": 221.86,
      "ko": "제가 중학생일 때",
      "zh": "제가 중학생일 때"
    },
    {
      "start": 221.86,
      "end": 225.09,
      "ko": "학교에 있던 친구들이 한 명 두 명...",
      "zh": "학교에 있던 친구들이 한 명 두 명..."
    },
    {
      "start": 225.09,
      "end": 229.23,
      "ko": "슬슬 스마트폰을 사기 시작을 했었거든요",
