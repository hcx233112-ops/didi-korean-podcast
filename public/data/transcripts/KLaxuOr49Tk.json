    },
    {
      "start": 241.66,
      "end": 243.5,
      "ko": "포인트가 하나가 있는데",
      "zh": "포인트가 하나가 있는데"
    },
    {
      "start": 243.5,
      "end": 245.7,
      "ko": "바로 '노란 1'이에요",
      "zh": "바로 '노란 1'이에요"
    },
    {
      "start": 245.7,
