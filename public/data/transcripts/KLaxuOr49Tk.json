      "end": 192.64,
      "ko": "그리고 매일매일 한 카톡 2~3개 정도를",
      "zh": "그리고 매일매일 한 카톡 2~3개 정도를"
    },
    {
      "start": 192.64,
      "end": 194.77,
      "ko": "주고받는 친구가 한 명에서...",
      "zh": "주고받는 친구가 한 명에서..."
    },
    {
      "start": 194.77,
      "end": 197.44,
      "ko": "세 명 정도 있는 것 같습니다",
      "zh": "세 명 정도 있는 것 같습니다"
    },
    {
      "start": 197.44,
      "end": 199.55,
      "ko": "그리고 오랜만에 친구들한테",
      "zh": "그리고 오랜만에 친구들한테"
    },
    {
      "start": 199.55,
      "end": 201.26,
      "ko": "연락이 올 때가 있잖아요",
      "zh": "연락이 올 때가 있잖아요"
    },
    {
      "start": 201.26,
      "end": 203.79,
      "ko": "그럴 때는 적어도",
      "zh": "그럴 때는 적어도"
    },
    {
      "start": 203.79,
      "end": 206.56,
      "ko": "답장을 하루 안에는 하는 것 같아요",
      "zh": "답장을 하루 안에는 하는 것 같아요"
    },
    {
      "start": 206.56,
      "end": 208.5,
      "ko": "그게 뭔가",
      "zh": "그게 뭔가"
    },
    {
      "start": 208.5,
      "end": 210.52,
      "ko": "상대방에 대한 예의가 아닌가",
      "zh": "상대방에 대한 예의가 아닌가"
    },
    {
      "start": 210.52,
      "end": 212.45,
      "ko": "저는 그렇게 생각을 합니다",
      "zh": "저는 그렇게 생각을 합니다"
    },
    {
      "start": 212.45,
      "end": 216.32,
      "ko": "근데 사실 저는 어렸을 때 학생일 때",
      "zh": "근데 사실 저는 어렸을 때 학생일 때"
    },
    {
      "start": 216.32,
      "end": 219.61,
      "ko": "친구들이랑 카톡을 훨씬 자주 했었어요",
