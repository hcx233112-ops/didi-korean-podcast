{
  "videoId": "KLaxuOr49Tk",
  "segments": [
    {
      "start": 5.18,
      "end": 9.15,
      "ko": "안녕하세요 <Didi의 한국어 Podcast>에 오신 여러분 반갑습니다",
      "zh": "안녕하세요 <Didi의 한국어 Podcast>에 오신 여러분 반갑습니다"
    },
    {
      "start": 9.15,
      "end": 13.02,
      "ko": "오늘은 2023년 7월 31일 월요일입니다",
      "zh": "오늘은 2023년 7월 31일 월요일입니다"
    },
    {
      "start": 13.02,
      "end": 15.55,
      "ko": "여러분, 벌써 7월의 마지막 날이에요...!",
      "zh": "여러분, 벌써 7월의 마지막 날이에요...!"
    },
    {
      "start": 15.55,
      "end": 18.62,
      "ko": "일 년의 반이 훌쩍 넘어버렸는데",
      "zh": "일 년의 반이 훌쩍 넘어버렸는데"
    },
    {
      "start": 18.62,
      "end": 20.72,
      "ko": "시간이 너무 믿을 수 없게",
      "zh": "시간이 너무 믿을 수 없게"
    },
    {
      "start": 20.72,
      "end": 22.88,
      "ko": "빠르게 흘러가고 있는 것 같아요",
      "zh": "빠르게 흘러가고 있는 것 같아요"
    },
    {
      "start": 22.88,
      "end": 25.55,
      "ko": "다들 저번 한 주도 잘 보내셨나요?",
      "zh": "다들 저번 한 주도 잘 보내셨나요?"
    },
    {
      "start": 25.55,
      "end": 28.61,
      "ko": "저는 지금 제 본가에 내려와 있습니다",
      "zh": "저는 지금 제 본가에 내려와 있습니다"
    },
    {
      "start": 28.61,
      "end": 32.16,
      "ko": "원래는 매주 주말마다 본가에 내려오는데",
      "zh": "원래는 매주 주말마다 본가에 내려오는데"
    },
    {
      "start": 32.16,
      "end": 36.0,
      "ko": "저번 주말에는 제 친구들이 놀러 오는 바람에",
      "zh": "저번 주말에는 제 친구들이 놀러 오는 바람에"
    },
    {
      "start": 36.0,
      "end": 40.46,
      "ko": "이번 주는 월요일에 본가에 있게 되었습니다",
      "zh": "이번 주는 월요일에 본가에 있게 되었습니다"
    },
    {
      "start": 40.46,
      "end": 43.18,
      "ko": "오늘은 저번 에피소드들에 이어서 계속해서",
      "zh": "오늘은 저번 에피소드들에 이어서 계속해서"
    },
    {
      "start": 43.18,
      "end": 46.54,
      "ko": "'한국의 연애'에 대해서 얘기를 해보려고 하는데요",
      "zh": "'한국의 연애'에 대해서 얘기를 해보려고 하는데요"
    },
    {
      "start": 46.54,
      "end": 48.32,
      "ko": "아마 당분간은 이게 마지막",
      "zh": "아마 당분간은 이게 마지막"
    },
    {
      "start": 48.32,
      "end": 51.14,
      "ko": "한국 연애 시리즈가 될 것 같습니다",
      "zh": "한국 연애 시리즈가 될 것 같습니다"
    },
    {
      "start": 51.14,
      "end": 53.5,
      "ko": "한국의 연애 중에도 오늘은",
      "zh": "한국의 연애 중에도 오늘은"
    },
    {
      "start": 53.5,
      "end": 56.99,
      "ko": "'연락'에 대해서 얘기를 해보려고 해요",
      "zh": "'연락'에 대해서 얘기를 해보려고 해요"
    },
    {
      "start": 56.99,
      "end": 58.74,
      "ko": "연락이라고 하면은",
      "zh": "연락이라고 하면은"
    },
    {
      "start": 58.74,
      "end": 60.45,
      "ko": "전화가 있을 수도 있고요",
      "zh": "전화가 있을 수도 있고요"
    },
    {
      "start": 60.45,
      "end": 62.82,
      "ko": "문자메시지를 보내는 것도 있고",
      "zh": "문자메시지를 보내는 것도 있고"
    },
    {
      "start": 62.82,
      "end": 66.39,
      "ko": "아니면 다양한 메신저 앱들도 많이 있잖아요",
      "zh": "아니면 다양한 메신저 앱들도 많이 있잖아요"
    },
    {
      "start": 66.39,
      "end": 70.51,
      "ko": "이런 연락과 연애가 무슨 상관이 있을까",
      "zh": "이런 연락과 연애가 무슨 상관이 있을까"
    },
    {
      "start": 70.51,
      "end": 72.2,
      "ko": "생각을 해보면",
      "zh": "생각을 해보면"
    },
    {
      "start": 72.2,
      "end": 74.75,
      "ko": "제가 외국사람들이랑 이야기를 할 때",
      "zh": "제가 외국사람들이랑 이야기를 할 때"
    },
    {
      "start": 74.75,
      "end": 76.88,
      "ko": "'한국인들은 연인 사이에서",
      "zh": "'한국인들은 연인 사이에서"
    },
    {
      "start": 76.88,
      "end": 79.25,
      "ko": "연락을 정말 많이 하는 것 같아요'",
      "zh": "연락을 정말 많이 하는 것 같아요'"
    },
    {
      "start": 79.25,
      "end": 81.15,
      "ko": "'정말 자주 하는 것 같아요'",
      "zh": "'정말 자주 하는 것 같아요'"
    },
    {
      "start": 81.15,
      "end": 84.46,
      "ko": "이런 얘기를 굉장히 많이 들었었어요",
      "zh": "이런 얘기를 굉장히 많이 들었었어요"
    },
    {
      "start": 84.46,
      "end": 88.24,
      "ko": "그래서 이번에는 한국에 있는 커플들은 정말로",
      "zh": "그래서 이번에는 한국에 있는 커플들은 정말로"
    },
    {
