      "zh": "얘기해 보려고 합니다"
    },
    {
      "start": 92.7,
      "end": 95.31,
      "ko": "근데 이렇게 사람에 관련된 것과",
      "zh": "근데 이렇게 사람에 관련된 것과"
    },
    {
      "start": 95.31,
      "end": 97.31,
      "ko": "뭔가 사랑에 관련된 거는",
      "zh": "뭔가 사랑에 관련된 거는"
    },
    {
      "start": 97.31,
      "end": 100.88,
      "ko": "제가 정답을 말씀해 드리기는 어려워서",
      "zh": "제가 정답을 말씀해 드리기는 어려워서"
    },
    {
      "start": 100.88,
      "end": 103.12,
