    },
    {
      "start": 135.83,
      "end": 138.04,
      "ko": "먼저 얘기를 해볼까 합니다",
      "zh": "먼저 얘기를 해볼까 합니다"
    },
    {
      "start": 138.04,
      "end": 139.92,
      "ko": "한국에는 연락을 할 수 있는",
