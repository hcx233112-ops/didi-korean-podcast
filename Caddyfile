:8080 {
	root * E:/claude/播客/audio

	# .mp4 is in Cloudflare's default cacheable extensions; .m4a is not.
	@episode path_regexp episode ^/([A-Za-z0-9_-]{11})\.mp4$
	# Only successful responses may be cached at the edge; never an error.
	header @episode {
		Content-Type "audio/mp4"
		Cache-Control "no-store"
	}
	header @episode {
		Cache-Control "public, max-age=604800"
		match status 200 206
	}
	rewrite @episode /{re.episode.1}.m4a

	@preflight method OPTIONS
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Headers Range
		Access-Control-Expose-Headers "Content-Range, Content-Length, Accept-Ranges"
	}
	respond @preflight 204

	file_server browse
}
