    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/youtube": "^0.2.0",
    "fengari": "^0.1.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
